{
  "name": "fast-vue3",
  "version": "1.0.0",
  "private": true,
  "description": "A Vue3 Monorepo engineering platform integrating multiple admin UI ecosystems",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 turbo build",
    "build:antd": "pnpm run build --filter=@fast-vue3/web-antd",
    "build:ele": "pnpm run build --filter=@fast-vue3/web-ele",
    "build:naive": "pnpm run build --filter=@fast-vue3/web-naive",
    "build:arco": "pnpm run build --filter=@fast-vue3/web-arco",
    "build:tdesign": "pnpm run build --filter=@fast-vue3/web-tdesign",
    "dev:antd": "turbo dev --filter=@fast-vue3/web-antd",
    "dev:ele": "turbo dev --filter=@fast-vue3/web-ele",
    "dev:naive": "turbo dev --filter=@fast-vue3/web-naive",
    "dev:arco": "turbo dev --filter=@fast-vue3/web-arco",
    "dev:tdesign": "turbo dev --filter=@fast-vue3/web-tdesign",
    "dev": "turbo-run dev",
    "typecheck": "turbo typecheck",
    "lint": "vsh lint",
    "lint:fix": "vsh lint --format",
    "format": "prettier --write \"**/*.{ts,mts,tsx,vue,mjs,cjs,json,md}\"",
    "clean": "node ./scripts/clean.mjs",
    "commit": "czg",
    "prepare": "lefthook install && pnpm -r run stub --if-present && pnpm -F @fast-vue3/vite-config build",
    "postinstall": "pnpm -r run stub --if-present",
    "preinstall": "npx only-allow pnpm"
  },
  "devDependencies": {
    "@fast-vue3/commitlint-config": "workspace:*",
    "@fast-vue3/eslint-config": "workspace:*",
    "@fast-vue3/oxfmt-config": "workspace:*",
    "@fast-vue3/oxlint-config": "workspace:*",
    "@fast-vue3/prettier-config": "workspace:*",
    "@fast-vue3/stylelint-config": "workspace:*",
    "@fast-vue3/tsconfig": "workspace:*",
    "@fast-vue3/turbo-run": "workspace:*",
    "@fast-vue3/vite-config": "workspace:*",
    "@fast-vue3/vsh": "workspace:*",
    "cross-env": "catalog:",
    "cz-git": "catalog:",
    "czg": "catalog:",
    "eslint": "catalog:",
    "lefthook": "catalog:",
    "lint-staged": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "prettier": "catalog:",
    "stylelint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vue-tsc": "catalog:"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.5.0"
  },
  "packageManager": "pnpm@9.15.9"
}
